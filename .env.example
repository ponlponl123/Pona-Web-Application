##
# Backend ENV
##

# Pona Application Endpoint
PONA_APPLICATION_ENDPOINT_HOST = "localhost"
PONA_APPLICATION_ENDPOINT_PORT = 3006
PONA_APPLICATION_ENDPOINT_KEY = "YOUR_API_KEY_HERE"

# Discord Login & Ponlponl123 API
DISCORD_CLIENT_SECRET = "YOUR_BOT_SECRET_HERE"
PONLPONL123_API_KEY = "YOUR_API_KEY_HERE"

##
# Public ENV
##

# Websocket Endpoint
NEXT_PUBLIC_PONA_APPLICATION_WS_ENDPOINT_PORT = 3007
NEXT_PUBLIC_PONA_APPLICATION_WS_ENDPOINT = "http://localhost"

# Discord Info
NEXT_PUBLIC_DISCORD_CLIENT_ID = "YOUR_CLIENT_ID_HERE"
NEXT_PUBLIC_DISCORD_OWNER_ID = "839208649325805639" # Ponlponl123
NEXT_PUBLIC_DISCORD_REDIRECT_ENDPOINT = "http://localhost:3000/app/callback"

# Public reverse-proxy hostnames allowed to forward Server Actions (comma-separated)
NEXT_SERVER_ACTIONS_ALLOWED_ORIGINS = ""
